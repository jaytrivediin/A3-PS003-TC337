# --- FedTraffic web (Next.js) -------------------------------------------
# URL of the Python FastAPI backend; the web server proxies /api/* to it.
BACKEND_URL=http://127.0.0.1:8000
# Optional: let the Next.js server spawn `python -m uvicorn app.main:app` from ./backend
FEDTRAFFIC_AUTOSTART_BACKEND=0
# Optional: python executable used for auto-start (default: backend/.venv/bin/python or python3)
# FEDTRAFFIC_PYTHON=python3
# Optional: call the backend directly from the browser instead of the proxy (needs CORS)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api
# Template leftover (not used by FedTraffic): PostgreSQL connection of the starter template
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
