# Copy to backend/.env to override defaults. All variables are optional.
FEDTRAFFIC_HOST=127.0.0.1
FEDTRAFFIC_PORT=8000
# Comma separated list of allowed browser origins (frontend dev servers)
FEDTRAFFIC_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173
# Storage locations (default: backend/data and backend/results)
# FEDTRAFFIC_DATA_DIR=/absolute/path/to/data
# FEDTRAFFIC_RESULTS_DIR=/absolute/path/to/results
# Real PEMS04 archive source (ASTGCN repository)
FEDTRAFFIC_PEMS04_URL=https://raw.githubusercontent.com/Davidham3/ASTGCN/master/data/PEMS04/pems04.npz
FEDTRAFFIC_PEMS04_FILENAME=pems04.npz
# Documented collection start (Jan-Feb 2018); timestamps are derived only if the array has 16992 steps
FEDTRAFFIC_PEMS04_START_DATE=2018-01-01
# Channel mapping of the NPZ array (verify against your copy of the dataset)
FEDTRAFFIC_FLOW_CHANNEL=0
FEDTRAFFIC_OCCUPANCY_CHANNEL=1
FEDTRAFFIC_SPEED_CHANNEL=2
# Chronological split ratios (must sum to 1)
FEDTRAFFIC_TRAIN_RATIO=0.7
FEDTRAFFIC_VAL_RATIO=0.1
FEDTRAFFIC_TEST_RATIO=0.2
# Fixed seed used to sample validation/test windows (identical across methods and seeds)
FEDTRAFFIC_EVAL_SAMPLE_SEED=7
# 0 = PyTorch default thread count
FEDTRAFFIC_TORCH_THREADS=0
